# ── Donation provider (Paystack) ─────────────────────────────
# Get your PUBLIC key from https://dashboard.paystack.com/#/settings/developers
# Use a test key (pk_test_...) while developing, live key (pk_live_...) in production.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Currency for donations (GHS = Ghana Cedi, USD = US Dollar)
VITE_DONATION_CURRENCY=GHS

# ── Contact form (Formspree) ─────────────────────────────────
# Create a free form at https://formspree.io and paste its endpoint id here.
VITE_FORMSPREE_ID=xxxxxxxx
